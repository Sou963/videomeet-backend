PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
GEMINI_API_KEY=
CLIENT_URL=http://localhost:3000

# Configure a TURN provider; comma-separated URLs may include UDP, TCP, and TLS endpoints.
TURN_URL=

# For coturn REST authentication, use a shared secret. The backend issues
# one-hour credentials and never sends this secret to the browser.
TURN_SHARED_SECRET=

# For providers that issue short-lived credentials directly, set these instead
# of TURN_SHARED_SECRET. Do not use a permanent provider secret here.
TURN_USERNAME=
TURN_CREDENTIAL=
